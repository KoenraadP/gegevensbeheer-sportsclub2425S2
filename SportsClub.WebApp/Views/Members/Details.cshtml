@model SportsClub.Entities.Member

@{
    ViewBag.Title = "Details";
}

<h2>Details</h2>

@* Eventueel feedback vanuit de Edit tonen *@
<p>@TempData["Feedback"]</p>

<div>
    <h4>Member</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.FirstName)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.FirstName)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.LastName)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.LastName)
        </dd>

        @* code om foto te tonen*@
        @* eerst de naam van de property (dit zal gewoon Picture zijn) *@

        <dt>
            @Html.DisplayNameFor(model => model.Picture)
        </dt>

        @* dan de waarde van de property *@
        @* let erop dat je Model hier met een hoofdletter moet typen *@
        <dd>
            <img src="~/Content/images/memberpics/@Model.Picture" width="200"
                 alt="Picture of @Model.FirstName @Model.LastName" />
        </dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.MemberId }) |
    @Html.ActionLink("Back to List", "Index")
</p>
